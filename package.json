{
  "name": "bellezza",
  "version": "1.0.0",
  "description": "Bellezza — The Science Behind Your Glow",
  "private": true,
  "scripts": {
    "start": "npm run start:frontend",
    "start:frontend": "npm start --prefix frontend",
    "start:backend": "npm start --prefix backend",
    "dev:backend": "npm run dev --prefix backend",
    "android": "npm run android --prefix frontend",
    "ios": "npm run ios --prefix frontend",
    "web": "npm run web --prefix frontend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "test": "npm test --prefix backend",
    "test:all": "npm run test:all --prefix backend"
  }
}
