PORT=5000
NODE_ENV=development
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_secure_random_secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=your_allowed_origin
# Optional external skincare API key (falls back to local INCI database if omitted)
DERMALYTICS_API_KEY=your_dermalytics_api_key_optional
